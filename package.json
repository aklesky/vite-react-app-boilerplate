{
    "name": "vite-react-app-boilerplate",
    "private": true,
    "version": "2.1.0",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "vite",
        "build": "pnpm run typecheck && vite build",
        "preview": "vite preview",
        "deploy": "pnpm run build && wrangler deploy",
        "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
        "lint": "oxlint",
        "format": "oxfmt --check",
        "test": "vitest run",
        "types": "wrangler types"
    },
    "dependencies": {
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@aklesky/oxc-presets": "0.1.1",
        "@aklesky/react-presets": "0.10.1",
        "@aklesky/tailwindcss-presets": "0.1.1",
        "@aklesky/typescript-presets": "0.1.1",
        "@aklesky/vitest-presets": "0.1.1",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "tailwindcss": "4.3.3",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "8.3.4",
        "vitest": "5.0.5",
        "wrangler": "4.152.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.22.1",
            "onFail": "download"
        }
    }
}
