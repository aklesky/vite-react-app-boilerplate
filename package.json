{
    "name": "vite-react-starter-tamplate",
    "private": true,
    "version": "0.0.4",
    "type": "module",
    "prettier": "@aklesky/prettier-config",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "npm run build && vite preview --outDir ../dist"
    },
    "devDependencies": {
        "@aklesky/eslint-config": "1.0.2",
        "@aklesky/jest-config": "1.0.2",
        "@aklesky/postcss-config": "1.0.1",
        "@aklesky/prettier-config": "1.0.1",
        "@aklesky/tailwind-config": "1.0.2",
        "@aklesky/ts-config": "1.0.1",
        "@aklesky/vite-config": "1.0.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "@aklesky/react-presets": "0.9.0"
    }
}
