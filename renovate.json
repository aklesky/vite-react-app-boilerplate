{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices", ":semanticCommits"],
    "schedule": ["before 9am on Monday"],
    "timezone": "Europe/Berlin",
    "rangeStrategy": "pin",
    "minimumReleaseAge": "7 days",
    "internalChecksFilter": "strict",
    "lockFileMaintenance": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "All minor and patch updates in one PR",
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "dependencies (minor-patch)"
        },
        {
            "description": "Own presets: no waiting period, so a preset release reaches the template on the next run",
            "matchPackageNames": ["@aklesky/*"],
            "minimumReleaseAge": "0 days"
        },
        {
            "description": "Majors wait for approval on the Dependency Dashboard, one PR each",
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true
        },
        {
            "description": "@types/node follows the Node.js 24 LTS line pinned in devEngines",
            "matchPackageNames": ["@types/node"],
            "allowedVersions": "<25"
        }
    ]
}
